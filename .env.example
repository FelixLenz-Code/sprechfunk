# Internal port the app listens on (behind your reverse proxy)
PORT=8080

# Host binding for docker-compose port publishing.
# BIND_ADDR: 0.0.0.0 = all interfaces (reverse proxy on another host can reach it),
#            127.0.0.1 = localhost only, or a concrete internal IP.
# The published port serves plain HTTP — TLS is terminated by your reverse proxy.
BIND_ADDR=0.0.0.0
HOST_PORT=8080

# Directory for the SQLite database and encrypted audio blobs
DATA_DIR=./data

# Secret used to sign JWT session tokens. MUST be changed and kept secret.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-please-openssl-rand-hex-32

# Secret used to encrypt stored voice-message blobs at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
MEDIA_ENCRYPTION_KEY=change-me-too-openssl-rand-hex-32

# Public origin of the app (used for CORS / cookie settings). e.g. https://talk.example.com
PUBLIC_ORIGIN=http://localhost:8080

# Voice-message retention: recordings older than this many days are auto-deleted
# (together with orphan audio files). Default 365 (one year). 0 disables retention.
VOICE_RETENTION_DAYS=365
# How often the cleanup job runs (hours).
CLEANUP_INTERVAL_HOURS=24
